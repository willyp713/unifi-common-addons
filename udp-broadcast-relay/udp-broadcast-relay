#!/bin/sh
# udp-broadcast-relay: run udp-broadcast-relay-redux as a systemd unit on a
# UniFi OS gateway. Usage and design: README.md. Run "udp-broadcast-relay help".
set -eu

PROG=udp-broadcast-relay
# UBR_ROOT prefixes every absolute path. Only the tests set it.
# On a gateway it is empty.
R="${UBR_ROOT:-}"
DATA="$R/data/unifi-common-addons/$PROG"
INST="$DATA/instances"
ONBOOT="$R/data/on_boot.d"
ONBOOT_NAME="20-$PROG.sh"
UNITS="$R/etc/systemd/system"
SYSNET="$R/sys/class/net"
UNIT_NAME="$PROG@.service"
BIN_NAME=udp-broadcast-relay-redux
SUMS="$DATA/SHA256SUMS"
LOCK="$R/run/$PROG.lock"
# run records the port of each relay it starts here. /run is empty after a
# reboot.
RUNDIR="$R/run/$PROG"
# Seconds to wait for another command to finish. Only the tests change it.
LOCK_WAIT="${UBR_LOCK_WAIT:-30}"

err() { printf '%s: ERROR: %s\n' "$PROG" "$*" >&2; }
die() { err "$*"; exit 1; }
note() { printf '%s: %s\n' "$PROG" "$*" >&2; }

usage() {
    cat <<'USAGE'
Usage: udp-broadcast-relay <command> [name]

Setup
  install           Copy the addon to /data (if it is elsewhere). Install the
                    boot entry and the unit. Starts nothing.
  enable <name>     Check the instance, mark it active, and start it.
  disable <name>    Stop the instance and remove its active mark. Keeps the
                    config.
  uninstall         Stop all instances. Remove the unit, the boot entry, and
                    the addon directory in /data.

Read-only
  status            Show each instance and the state of the addon.
  precheck <name>   Check the config, the interfaces, and the binary.

Called by systemd and by the boot entry
  boot              Restore the unit. Start each active instance.
  run <name>        Run the relay in the foreground.
USAGE
}

# ---------- files ----------

# put MODE SRC DST: copy only when the content differs. Returns 0 when it
# wrote DST and 1 when DST was already the same. A failed write stops the
# script. (set -e does not act inside a function that an || or if tests, so
# each step checks its own result.) DST is replaced only by a whole copy.
# The temporary name holds the process ID, so two runs never share it.
put() {
    if [ -f "$3" ] && cmp -s "$2" "$3"; then
        chmod "$1" "$3" || die "cannot chmod $3"
        return 1
    fi
    mkdir -p "$(dirname "$3")" || die "cannot create the directory of $3"
    tmp="$3.new.$$"
    if ! { cp "$2" "$tmp" && chmod "$1" "$tmp" && mv -f "$tmp" "$3"; }; then
        rm -f "$tmp"
        die "cannot write $3"
    fi
}

# lock: let one changing command run at a time. Two boot runs can overlap
# when two launchers call the boot entry. The lock ends when the script
# exits.
lock() {
    mkdir -p "$(dirname "$LOCK")" || die "cannot create the directory of $LOCK"
    exec 9>"$LOCK" || die "cannot open $LOCK"
    flock -w "$LOCK_WAIT" 9 || die "another $PROG command is running (lock $LOCK)"
}

# clean_tmp: remove the temporary copies that a put() cut short by a power
# loss left behind. Call it only while holding the lock: every put() runs
# under the lock, so no temporary copy is in use then. It looks only at the
# files that put() writes, and only at names that end in .new.<digits>.
clean_tmp() {
    for f in "$ONBOOT/$ONBOOT_NAME".new.* "$UNITS/$UNIT_NAME".new.* \
        "$DATA/$PROG".new.* "$DATA/systemd/$UNIT_NAME".new.* \
        "$DATA/on_boot.d/$ONBOOT_NAME".new.* "$SUMS".new.* \
        "$INST"/*/relay.conf.example.new.* "$DATA"/bin/*/"$BIN_NAME".new.*; do
        [ -f "$f" ] || continue
        case ${f##*.new.} in ''|*[!0-9]*) continue ;; esac
        rm -f "$f"
    done
}

# no_args COMMAND ARGS...: COMMAND takes no arguments.
no_args() {
    c=$1; shift
    [ $# -eq 0 ] || die "$c takes no arguments (got: $*)"
}

valid_name() {
    case $1 in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
}

need_name() {
    [ $# -ge 1 ] || die "missing instance name"
    [ $# -eq 1 ] || die "give one instance name (got: $*)"
    valid_name "$1" || die "bad instance name '$1' (use letters, digits, - and _)"
}

# need_instance NAME: the addon home, the instances directory, and the
# instance directory are real directories, and the active mark is not a
# symlink. A symlink at any of them could point into another addon, and
# enable or disable would then write or delete that addon's file.
need_instance() {
    [ ! -L "$DATA" ] || die "$DATA is a symlink"
    [ ! -L "$INST" ] || die "$INST is a symlink"
    { [ -d "$INST/$1" ] && [ ! -L "$INST/$1" ]; } || die "no instance directory $1 (a symlink is not accepted)"
    [ ! -L "$INST/$1/active" ] || die "$INST/$1/active is a symlink"
}

# ---------- config ----------

# parse_conf NAME: set ID, PORT, DEVS, TARGET. The file is data, not shell.
parse_conf() {
    conf="$INST/$1/relay.conf"
    [ -f "$conf" ] || { err "no config at $conf"; return 1; }
    ID='' PORT='' DEVS='' TARGET=''
    seen=
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in ''|'#'*) continue ;; esac
        key=${line%%=*}
        val=${line#*=}
        if [ "$key" = "$line" ]; then
            err "$conf: line is not KEY=VALUE: $line"
            return 1
        fi
        val=${val#\"}
        val=${val%\"}
        case " $seen " in *" $key "*) err "$conf: $key is set twice"; return 1 ;; esac
        seen="$seen $key"
        case $key in
        ID) ID=$val ;;
        PORT) PORT=$val ;;
        DEVS) DEVS=$val ;;
        TARGET) TARGET=$val ;;
        *) err "$conf: unknown key $key"; return 1 ;;
        esac
    done <"$conf"
}

# is_count VALUE MIN MAX: a plain decimal number in range.
is_count() {
    case $1 in ''|*[!0-9]*|0?*) return 1 ;; esac
    [ "${#1}" -le 5 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

# check_values: ID, PORT, DEVS, and TARGET are present and well formed.
check_values() {
    is_count "$ID" 1 99 || { err "ID '$ID' is not a number from 1 to 99"; return 1; }
    # The relay marks its copies with TTL ID+64 and drops each packet that
    # arrives with that TTL. 128 is the default TTL of Windows.
    [ "$ID" != 64 ] || { err "ID 64 would drop packets from Windows hosts (TTL 128); use another ID"; return 1; }
    is_count "$PORT" 1 65535 || { err "PORT '$PORT' is not a number from 1 to 65535"; return 1; }
    [ -n "$TARGET" ] || { err "TARGET is missing"; return 1; }
    case $TARGET in *[!0-9.]*) err "TARGET '$TARGET' is not one IPv4 address"; return 1 ;; esac
    count=0
    seen=
    set -f
    for d in $DEVS; do
        case $d in
        *[!A-Za-z0-9_.@-]*) set +f; err "bad interface name '$d'"; return 1 ;;
        esac
        [ "${#d}" -le 15 ] || { set +f; err "interface name '$d' is too long"; return 1; }
        case " $seen " in *" $d "*) set +f; err "interface $d is listed twice"; return 1 ;; esac
        seen="$seen $d"
        count=$((count + 1))
    done
    set +f
    [ "$count" -ge 2 ] || { err "DEVS needs two or more interfaces (found $count)"; return 1; }
}

# cidr_bcast A.B.C.D/LEN: print the broadcast address of that network.
# Prints nothing for a /31, a /32, or a malformed address.
cidr_bcast() {
    addr=${1%/*}
    len=${1#*/}
    is_count "$len" 1 30 || return 0
    oldifs=$IFS
    IFS=.
    # shellcheck disable=SC2086
    set -- $addr
    IFS=$oldifs
    [ $# -eq 4 ] || return 0
    for o in "$@"; do is_count "$o" 0 255 || [ "$o" = 0 ] || return 0; done
    ipn=$(($1 << 24 | $2 << 16 | $3 << 8 | $4))
    mask=$((0xFFFFFFFF << (32 - len) & 0xFFFFFFFF))
    bc=$((ipn | (~mask & 0xFFFFFFFF)))
    printf '%d.%d.%d.%d\n' $((bc >> 24 & 255)) $((bc >> 16 & 255)) $((bc >> 8 & 255)) $((bc & 255))
}

# dev_bcasts DEV: the broadcast address of each IPv4 network on DEV.
# UniFi OS sets no broadcast address on its bridges, so compute it.
dev_bcasts() {
    out=$(ip -4 -o addr show dev "$1" 2>/dev/null) || return 0
    printf '%s\n' "$out" | while read -r _ _ fam cidr _; do
        [ "$fam" = inet ] && cidr_bcast "$cidr"
    done
}

# bin_hash_ok BIN: BIN has the SHA-256 that SHA256SUMS lists for this CPU.
# The relay runs as root, so no other binary may run.
bin_hash_ok() {
    want=$(sed -n "s|^\([0-9a-f]\{64\}\)  $(uname -m)/$BIN_NAME\$|\1|p" "$SUMS" 2>/dev/null | head -n 1)
    [ -n "$want" ] || { err "$SUMS lists no hash for $(uname -m)"; return 1; }
    have=$(sha256sum "$1" | cut -d' ' -f1)
    [ "$have" = "$want" ] || { err "$1 does not have the hash in $SUMS"; return 1; }
}

# check_system NAME: the parts that depend on this gateway.
check_system() {
    bcasts=
    for d in $DEVS; do
        [ -d "$SYSNET/$d" ] || { err "interface $d does not exist"; return 1; }
        flags=$(cat "$SYSNET/$d/flags" 2>/dev/null) || flags=0
        # The relay skips an interface without IFF_UP and does not say so.
        [ $((flags & 1)) -eq 1 ] || { err "interface $d is down"; return 1; }
        # The relay skips a loopback interface and does not say so.
        [ $((flags & 8)) -eq 0 ] || { err "interface $d is a loopback interface"; return 1; }
        # The relay exits at start when an interface has no IPv4 address.
        a=$(ip -4 -o addr show dev "$d" 2>/dev/null) || a=
        [ -n "$a" ] || { err "interface $d has no IPv4 address"; return 1; }
        bcasts="$bcasts $(dev_bcasts "$d" | tr '\n' ' ')"
    done
    found=0
    for b in $bcasts; do
        [ "$b" != "$TARGET" ] || found=1
    done
    [ "$found" -eq 1 ] || {
        err "TARGET $TARGET is not the broadcast address of a network on $DEVS (found:${bcasts:- none})"
        return 1
    }
    # Two relays on one port copy each other's packets without end. The
    # relay sets SO_REUSEPORT, so the second one starts without an error.
    # Check the running relays first: a config can change after its start.
    for f in "$RUNDIR"/*.port; do
        [ -f "$f" ] || continue
        oname=${f##*/}
        oname=${oname%.port}
        { [ "$oname" != "$1" ] && valid_name "$oname"; } || continue
        [ "$(cat "$f")" = "$PORT" ] || continue
        if systemctl is-active --quiet "$PROG@$oname.service"; then
            err "instance $oname is running on port $PORT"
            return 1
        fi
    done
    for other in "$INST"/*/; do
        [ -d "$other" ] || continue
        other=${other%/}
        oname=${other##*/}
        { [ "$oname" != "$1" ] && [ -f "$other/active" ]; } || continue
        oport=$(sed -n 's/^PORT="\{0,1\}\([0-9]*\)"\{0,1\}$/\1/p' "$other/relay.conf" 2>/dev/null | head -n 1)
        if [ "$oport" = "$PORT" ]; then
            err "instance $oname is active on port $PORT"
            return 1
        fi
    done
    bin="$DATA/bin/$(uname -m)/$BIN_NAME"
    [ -x "$bin" ] || { err "no executable binary at $bin"; return 1; }
    # Check the hash before the binary runs for the first time.
    bin_hash_ok "$bin" || return 1
    # With no arguments the relay prints its usage and exits 1.
    rc=0
    "$bin" >/dev/null 2>&1 || rc=$?
    [ "$rc" -eq 1 ] || { err "$bin does not run on this CPU (exit $rc)"; return 1; }
}

cmd_precheck() {
    need_name "$@"
    need_instance "$1"
    parse_conf "$1" || return 1
    check_values || return 1
    check_system "$1" || return 1
}

# ---------- units ----------

reload() { systemctl daemon-reload; }

# install_unit: restore the unit file. /data survives a firmware update and
# /etc/systemd/system does not. Returns 0 when the file changed.
install_unit() {
    [ -f "$DATA/systemd/$UNIT_NAME" ] || die "missing $DATA/systemd/$UNIT_NAME"
    put 0644 "$DATA/systemd/$UNIT_NAME" "$UNITS/$UNIT_NAME"
}

install_onboot() {
    [ -f "$DATA/on_boot.d/$ONBOOT_NAME" ] || die "missing $DATA/on_boot.d/$ONBOOT_NAME"
    put 0755 "$DATA/on_boot.d/$ONBOOT_NAME" "$ONBOOT/$ONBOOT_NAME" || true
}

each_instance() { # prints instance names
    for d in "$INST"/*/; do
        [ -d "$d" ] || continue
        d=${d%/}
        printf '%s\n' "${d##*/}"
    done
}

# ---------- commands ----------

cmd_install() {
    no_args install "$@"
    lock
    self=$(cd "$(dirname "$0")" && pwd -P)
    # Check the copy before the first write, so that an incomplete copy
    # changes nothing.
    for f in "$self/$PROG" "$self/systemd/$UNIT_NAME" "$self/on_boot.d/$ONBOOT_NAME"; do
        [ -f "$f" ] || die "missing $f; run install from a full copy of the addon. Nothing changed."
    done
    clean_tmp
    mkdir -p "$DATA"
    here=$(cd "$DATA" && pwd -P)
    if [ "$self" != "$here" ]; then
        put 0755 "$self/$PROG" "$DATA/$PROG" || true
        put 0644 "$self/systemd/$UNIT_NAME" "$DATA/systemd/$UNIT_NAME" || true
        put 0755 "$self/on_boot.d/$ONBOOT_NAME" "$DATA/on_boot.d/$ONBOOT_NAME" || true
        for f in "$self"/instances/*/relay.conf.example; do
            [ -f "$f" ] || continue
            n=${f%/*}
            put 0644 "$f" "$DATA/instances/${n##*/}/relay.conf.example" || true
        done
        [ ! -f "$self/SHA256SUMS" ] || put 0644 "$self/SHA256SUMS" "$SUMS" || true
        for f in "$self"/bin/*/"$BIN_NAME"; do
            [ -f "$f" ] || continue
            n=${f%/*}
            put 0755 "$f" "$DATA/bin/${n##*/}/$BIN_NAME" || true
        done
    fi
    install_onboot
    if install_unit; then reload; fi
    # precheck needs both, so say now rather than at the first enable.
    [ -f "$SUMS" ] || note "WARNING: no $SUMS. precheck will refuse to start a relay. Run install from a full copy of the addon."
    [ -f "$DATA/bin/$(uname -m)/$BIN_NAME" ] || note "WARNING: no binary at $DATA/bin/$(uname -m)/$BIN_NAME. Build it with tools/build.sh."
    note "installed. Create instances/<name>/relay.conf, then: $PROG enable <name>"
}

cmd_boot() {
    no_args boot "$@"
    lock
    clean_tmp
    if [ -d "$DATA" ] && install_unit; then reload; fi
    each_instance | while read -r name; do
        [ -f "$INST/$name/active" ] || continue
        valid_name "$name" || continue
        # --no-block: the boot hook must not wait for the relay.
        systemctl start --no-block "$PROG@$name.service" || note "could not start $name"
    done
}

cmd_enable() {
    need_name "$@"
    lock
    cmd_precheck "$1" || die "not enabling $1"
    : >"$INST/$1/active"
    systemctl restart "$PROG@$1.service"
    note "$1 enabled"
}

cmd_disable() {
    need_name "$@"
    lock
    name=$1
    need_instance "$name"
    # If the stop fails the relay may still run, so keep the active mark:
    # it is what holds back a second instance on the same port.
    systemctl stop "$PROG@$name.service" || die "could not stop $name; it stays active"
    rm -f "${INST:?}/$name/active"
    note "$name disabled (config kept)"
}

cmd_run() {
    # Check again: the config may have changed since ExecStartPre.
    cmd_precheck "$@" || exit 1
    # Record the port, for the check in check_system.
    { mkdir -p "$RUNDIR" && printf '%s\n' "$PORT" >"$RUNDIR/$1.port"; } || die "cannot write $RUNDIR/$1.port"
    set --  --id "$ID" --port "$PORT" -t "$TARGET"
    for d in $DEVS; do set -- "$@" --dev "$d"; done
    exec "$DATA/bin/$(uname -m)/$BIN_NAME" "$@"
}

cmd_status() {
    no_args status "$@"
    echo "home:       $DATA"
    [ -f "$ONBOOT/$ONBOOT_NAME" ] && b=present || b=missing
    echo "boot entry: $b"
    [ -f "$UNITS/$UNIT_NAME" ] && b=present || b=missing
    echo "unit:       $b"
    bin="$DATA/bin/$(uname -m)/$BIN_NAME"
    if [ -f "$bin" ]; then
        if bin_hash_ok "$bin" 2>/dev/null; then
            h="hash matches SHA256SUMS"
        else
            h="HASH DOES NOT MATCH SHA256SUMS"
        fi
        echo "binary:     $(sha256sum "$bin" | cut -c1-16)... ($(uname -m)), $h"
    else
        echo "binary:     missing ($bin)"
    fi
    each_instance | while read -r name; do
        [ -f "$INST/$name/active" ] && e=enabled || e=disabled
        s=$(systemctl is-active "$PROG@$name.service" 2>/dev/null) || true
        echo "instance $name: $e, unit ${s:-unknown}"
    done
}

cmd_uninstall() {
    no_args uninstall "$@"
    lock
    case $DATA in */"$PROG") ;; *) die "refusing to remove $DATA" ;; esac
    for d in "$INST"/*/; do
        [ -d "$d" ] || continue
        d=${d%/}
        name=${d##*/}
        valid_name "$name" || continue
        systemctl stop "$PROG@$name.service" || die "could not stop $name; nothing was removed"
    done
    # A relay whose instance directory was renamed or deleted still runs.
    for f in "$RUNDIR"/*.port; do
        [ -f "$f" ] || continue
        name=${f##*/}
        name=${name%.port}
        valid_name "$name" || continue
        systemctl stop "$PROG@$name.service" || die "could not stop $name; nothing was removed"
    done
    rm -f "${UNITS:?}/$UNIT_NAME" "${ONBOOT:?}/$ONBOOT_NAME"
    reload || true
    rm -rf "${DATA:?}" "${RUNDIR:?}"
    note "uninstalled"
}

cmd=${1:-help}
[ $# -eq 0 ] || shift
case $cmd in
install) cmd_install "$@" ;;
boot) cmd_boot "$@" ;;
enable) cmd_enable "$@" ;;
disable) cmd_disable "$@" ;;
precheck) cmd_precheck "$@" ;;
run) cmd_run "$@" ;;
status) cmd_status "$@" ;;
uninstall) cmd_uninstall "$@" ;;
help|-h|--help) usage ;;
*) usage >&2; exit 2 ;;
esac
